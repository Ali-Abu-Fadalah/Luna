{
  "name": "luna-extension",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "test": "node --preserve-symlinks-main --preserve-symlinks scripts/test.mjs",
    "format:check": "node --preserve-symlinks-main --preserve-symlinks node_modules/prettier/bin/prettier.cjs --check \"src/**/*.js\" \"tests/**/*.js\" \"scripts/*.mjs\"",
    "format": "node --preserve-symlinks-main --preserve-symlinks node_modules/prettier/bin/prettier.cjs --write \"src/**/*.js\" \"tests/**/*.js\" \"scripts/*.mjs\"",
    "security:check": "node --preserve-symlinks-main --preserve-symlinks scripts/security-check.mjs",
    "package": "node --preserve-symlinks-main --preserve-symlinks scripts/package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
